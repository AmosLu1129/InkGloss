# Python 缓存与构建产物
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# 虚拟环境
.venv/
venv/
env/
ENV/

# 运行时数据、离线词典（~850MB）、本地书籍与临时下载包
data/*
!data/.gitkeep

# 本地模型权重与大体积二进制
models/
*.bin
*.safetensors
*.onnx

# 日志与临时文件
*.log
*.tmp
*.bak
*.swp
*.swo
logs/
tmp/

# 操作系统与编辑器文件
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
